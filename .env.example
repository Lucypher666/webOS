# ============================================================
# WebOS — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# ------- DATABASE -------
# PostgreSQL connection string (required for production)
# Get a free database at: https://neon.tech | https://supabase.com | https://railway.app
DATABASE_URL="postgresql://user:password@host:5432/webos?schema=public"

# ------- AUTH -------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-real-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ------- EMAIL (Resend) -------
# Sign up at https://resend.com — free tier available
# Without this, emails are only logged to console (dev mode)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="WebOS <noreply@yourdomain.com>"

# ------- STRIPE (Billing) -------
# Sign up at https://stripe.com
# Leave blank to disable billing features
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Create products/prices in your Stripe dashboard and paste the price IDs here
STRIPE_STARTER_PRICE_ID="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRO_PRICE_ID="price_xxxxxxxxxxxxxxxxxxxx"

# ------- STORAGE (Optional — for cloud media uploads) -------
# If not set, files are saved to /public/uploads (not suitable for production)
# Cloudinary: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
